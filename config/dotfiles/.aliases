# ~/.aliases
#
# Shell aliases and helper functions for common developer workflows.
#
# ============================================================================
# Shell compatibility: bash/zsh only -- NOT POSIX
# ============================================================================
#
# This file is intended for bash and zsh. It is NOT POSIX-compatible
# (sh / dash / ash). Do not source it from /bin/sh -- the non-POSIX
# features below will fail to parse or misbehave.
#
# Non-POSIX features intentionally used in this file:
#
#   [[ ... ]]              -- extended test command (bash/zsh, not POSIX)
#   [[ ... =~ ... ]]       -- regex match operator (bash/zsh)
#   local <var>            -- function-local variables (bash/ksh/zsh)
#   $BASH_VERSION          -- shell-detection variable used by `sb` alias
#   $ZSH_VERSION           -- shell-detection variable used by `sz` alias
#   alias -- -='cd -'      -- `alias --` long-option terminator (bash/zsh)
#
# Note: function definitions use the POSIX `name() { ... }` form, but the
# bodies use `local` (non-POSIX), so the file as a whole is bash/zsh-only.
#
# If you need POSIX compatibility, do NOT source this file from /bin/sh.
# Maintain a separate POSIX-only rc file for sh/dash/ash environments.
#
# ============================================================================
# Loading pattern
# ============================================================================
#
# Sourced from ~/.bashrc and ~/.zshrc. The dotfile installer
# (config/dotfiles/install.sh) wires this in for new shells; existing shells
# pick it up on next launch or via the `reload` / `sb` / `sz` aliases.
# See README.md "Shell Aliases" for the cross-platform picture and the
# Windows-side equivalent in scripts/windows/tools/profile.ps1.
#
# Categories:
#   - Navigation
#   - ls shortcuts
#   - Git
#   - GitHub CLI (gh)
#   - Docker (optional)
#   - Tmux
#   - Utility
#   - Dev shortcuts

# ── Navigation ───────────────────────────────────────────────────────────────

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias -- -='cd -'

# ── ls shortcuts ─────────────────────────────────────────────────────────────

alias ls='ls --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias lh='ls -alFh'          # human-readable sizes

# ── Git ──────────────────────────────────────────────────────────────────────

alias ga='git add'                                                                                    # stage a file
alias gaa='git add --all'                                                                             # stage all changes
alias gb='git branch'                                                                                # list, create, or delete branches
alias gc='git commit -v'                                                                              # commit with verbose diff
alias gcm='git commit -m'                                                                             # commit with inline message
alias gcb='git checkout -b'                                                                           # create and switch to new branch
alias gco='git checkout'                                                                              # switch branch or restore file
alias gd='git diff'                                                                                   # show unstaged diff
alias gds='git diff --staged'                                                                         # show staged diff
alias gf='git fetch'                                                                                  # fetch from remote
alias gfp='git fetch --prune'                                                                         # fetch and prune stale remote branches
alias ggs='git stash'                                                                                 # stash current changes
alias ggsls='git stash list'                                                                          # list all stashes
alias ggsp='git stash pop'                                                                            # pop most recent stash
alias gl="git log --graph --abbrev-commit --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'"  # pretty graph log
alias glog='git log'                                                                                  # full git log
alias gp='git push'                                                                                   # push to remote
alias gpf='git push --force-with-lease'                                                               # safe force push
alias gpl='git pull'                                                                                  # pull from remote
alias grb='git rebase'                                                                                # rebase onto branch
alias grbi='git rebase -i'                                                                            # interactive rebase
alias grs='git restore'                                                                               # discard working tree changes
alias grss='git restore --staged'                                                                     # unstage a file
alias gs='git status -sb'                                                                             # short branch status

# ── GitHub CLI (gh) ──────────────────────────────────────────────────────────

alias ghpr='gh pr create'
alias ghprl='gh pr list'
alias ghprv='gh pr view'
alias ghis='gh issue list'
alias ghiv='gh issue view'

# ── Docker (optional — only useful if Docker is installed) ───────────────────

alias dk='docker'
alias dkc='docker-compose'
alias dkps='docker ps'
alias dkpsa='docker ps -a'

# ── Tmux ─────────────────────────────────────────────────────────────────────

alias tls="tmux ls"                           # list active tmux sessions
alias tks="tmux kill-server"                  # kill all tmux sessions
alias tt="tmux new-session -s tank_dev"       # create a new named tmux session
alias ta="tmux attach"                        # attach to most recent tmux session

# ── Utility ──────────────────────────────────────────────────────────────────

alias c='clear'
alias h='history'
alias path='echo $PATH | tr ":" "\n"'         # print PATH entries one per line
alias reload='source ~/.zshrc 2>/dev/null || source ~/.bashrc'
alias myip='curl -s ifconfig.me'
alias pb='ping bing.com'              # quick connectivity check
alias ports='ss -tulnp'
alias vb="vim ~/.bashrc"                      # edit bash config in vim
alias sb='[[ -n "$BASH_VERSION" ]] && source ~/.bashrc || echo "[sb] Not in bash — use sz"'   # reload bash config (bash only)
alias vz="vim ~/.zshrc"                       # edit zsh config in vim
alias sz='[[ -n "$ZSH_VERSION"  ]] && source ~/.zshrc  || echo "[sz] Not in zsh — use sb"'    # reload zsh config (zsh only)
alias vv="vim ~/.vimrc"                       # edit vim config in vim
alias va="vim ~/.aliases"                     # edit aliases file in vim
alias ep='${EDITOR:-vim} ~/.bash_profile'    # open profile in editor

# ── Dev shortcuts ────────────────────────────────────────────────────────────

alias py='python3'
alias pip='pip3'
alias uvr='uv run'
alias uvs='uv sync'
alias ni='npm install'
alias nr='npm run'
alias nrd='npm run dev'
alias nrt='npm run test'
alias gosquad='copilot --agent squad --yolo'

# ── Squad HQ env (Codespaces only) ───────────────────────────────────────────

if [[ -n "${CODESPACES:-}" ]]; then
  export SQUAD_HQ_ROOT="/workspaces/clonewars-squad-hq"
  export SQUAD_WORK_REPO="${GITHUB_REPOSITORY##*/}"
fi

# ── Functions ────────────────────────────────────────────────────────────────

# Create or attach to the tank_dev tmux session
create_tmux() {
  local session="tank_dev"
  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session"
  fi
  tmux attach -t "$session"
}

# Run on shell startup — launch tmux session
start_up() {
  create_tmux
}

# ── Shutdown (Windows host on WSL; sudo on native Linux/macOS) ────────────────

# Heuristic detection, evaluated only on invocation. WSL environment variables
# are ambiguity hints, not authority; custom kernels/containers have limits.
_dev_setup_shutdown_platform() {
  local os kernel
  if ! os=$(uname -s); then
    printf '%s\n' 'shutdown helpers: unable to detect OS with uname -s' >&2
    return 1
  fi
  case "$os" in
    Linux)
      if ! kernel=$(cat /proc/version 2>/dev/null) || [[ -z "$kernel" ]]; then
        printf '%s\n' 'shutdown helpers: unable to read a nonempty /proc/version; platform is indeterminate' >&2
        return 1
      fi
      case "$kernel" in
        *[Mm][Ii][Cc][Rr][Oo][Ss][Oo][Ff][Tt]*)
          if ! command -v shutdown.exe >/dev/null 2>&1; then
            printf '%s\n' 'shutdown helpers: WSL requires shutdown.exe on PATH and Windows interop enabled' >&2
            return 1
          fi
          printf '%s\n' wsl
          ;;
        *)
          if [[ -n "${WSL_DISTRO_NAME:-}" || -n "${WSL_INTEROP:-}" ]]; then
            printf '%s\n' 'shutdown helpers: ambiguous platform: Linux kernel lacks Microsoft marker but WSL_DISTRO_NAME or WSL_INTEROP is set; verify the platform and correct the environment manually' >&2
            return 1
          fi
          printf '%s\n' linux
          ;;
      esac
      ;;
    Darwin) printf '%s\n' macos ;;
    *) printf 'shutdown helpers: unsupported OS: %s\n' "$os" >&2; return 1 ;;
  esac
}

# Shut down immediately. WSL interop failures never fall back to native shutdown.
sdn() {
  local platform
  platform=$(_dev_setup_shutdown_platform) || return $?
  case "$platform" in
    wsl) shutdown.exe /s /t 0 ;;
    linux|macos) sudo shutdown -h now ;;
  esac
}

# Timed shutdown — usage: tsdn <minutes>
tsdn() {
  if [[ $# -ne 1 || ! "${1:-}" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' 'tsdn: usage: tsdn <minutes> (one positive decimal integer, no leading zeros)' >&2
    return 1
  fi
  local platform minutes="$1"
  platform=$(_dev_setup_shutdown_platform) || return $?
  case "$platform" in
    wsl)
      # Bound the decimal string before arithmetic (also safe on Bash 3.2).
      if [[ ${#minutes} -gt 7 ]] || [[ ${#minutes} -eq 7 && "$minutes" -gt 5256000 ]]; then
        printf '%s\n' 'tsdn: WSL delay must not exceed 5256000 minutes' >&2
        return 1
      fi
      printf '%s\n' 'tsdn: warning: a positive Windows timeout forces applications to close; unsaved work may be lost.' >&2
      shutdown.exe /s /t "$((minutes * 60))"
      ;;
    linux|macos) sudo shutdown -h +"$minutes" ;;
  esac
}

# Cancel a pending shutdown system-wide, preserving the command's diagnostics/status.
cancel_tsdn() {
  local platform
  platform=$(_dev_setup_shutdown_platform) || return $?
  case "$platform" in
    wsl) shutdown.exe /a ;;
    linux) sudo shutdown -c ;;
    macos) sudo killall shutdown ;;
  esac
}
