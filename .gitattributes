# Enforce LF line endings for all text files on checkout
* text=auto eol=lf

# Explicit overrides for key file types
*.sh      text eol=lf
*.bash    text eol=lf
*.zsh     text eol=lf
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.psd1    text eol=crlf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
.aliases  text eol=lf
.vimrc    text eol=lf
